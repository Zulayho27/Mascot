# AI provayderini tanlang: openai | gemini | anthropic | demo
AI_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Anthropic Claude (ixtiyoriy)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Ma'lumotlar bazasi: PostgreSQL (Vercel da Neon integratsiyasi DATABASE_URL ni o‘zi qo‘yadi)
DATABASE_URL="postgresql://hamida:hamida@localhost:5432/hamida"
# Sessiya imzosi uchun kamida 32 belgili tasodifiy satr: openssl rand -base64 48
AUTH_SECRET=
